};

const steps = [
{
  nav:"Dry Sift Hash",
  kicker:"01 · separação a seco",
  title:"Dry Sift Hash",
  image:images.dry,
  lead:`O <strong>hash, ou haxixe</strong>, é um concentrado feito a partir da resina da cannabis. Essa resina se concentra principalmente nos <strong>tricomas</strong>, pequenas estruturas que recobrem a flor.`,
  facts:[
    ["Como é obtido","No Dry Sift, flor seca e curada passa por telas. Os tricomas que se desprendem são coletados."],
    ["Kief","O material solto, rico em tricomas, coletado nessa separação é chamado <strong>kief</strong>."],
    ["Micragem","As telas têm aberturas medidas em <strong>microns (µm)</strong>. Micragens diferentes deixam passar partículas de tamanhos diferentes."],
    ["O resultado","A fração rica em tricomas separada a seco dá origem ao <strong>Dry Sift Hash</strong>."]
  ],
  key:`<strong>Flor → tricomas → resina separada → Hash.</strong>`
},
{
  nav:"Ice Water Hash",
  kicker:"02 · separação em água fria",
