320px,1fr) minmax(320px,1fr);gap:20px;align-items:start;}.progress{overflow-x:auto;display:flex;scrollbar-width:none}.progress::-webkit-scrollbar{display:none}.progress button{min-width:max-content;margin-right:18px}}@media(max-width:720px){.shell{width:calc(100% - 18px);padding-top:14px}.masthead{position:relative;padding-top:36px;gap:10px}.brand-lockup{grid-template-columns:44px minmax(0,1fr);gap:11px}.brand-logo{width:44px}.masthead h1{font-size:clamp(28px,9.8vw,42px);line-height:.97}.masthead p{font-size:10.5px}.mast-actions{position:absolute;right:0;top:0}.counter{font-size:15px}.page,.page[data-step="0"],.page[data-step="1"],.page[data-step="2"],.page[data-step="3"],.page[data-step="4"],.page[data-step="5"]{display:flex;flex-direction:column;gap:0;}.media{height:345px;min-height:345px;margin-bottom:18px}.story{padding:0 1px 4px}.story h2{font-size:clamp(40px,14vw,60px)}.lead{font-size:13px}.key{font-size:15px}.fact{grid-template-columns:95px minmax(0,1fr);gap:13px}.fact dd{font-size:10.5px}.mindmap{grid-template-columns:1fr 1fr}.family{grid-template-columns:1fr}.family-head{grid-template-columns:1fr;gap:4px}.compare-row .name{font-size:21px}}</style></head><body><div class="shell"><header class="masthead"><div class="brand-lockup"><img class="brand-logo" src="/brand/adapta-logo-board-trim.png" alt="Adapta"><div class="brand-copy"><div class="overline" id="headerOverline">Guia visual · solventless</div><h1 id="headerTitle">Um guia pra entender melhor o universo das extrações</h1><p id="headerIntro">Do Dry Sift ao Live Hash Rosin, um panorama visual das principais extrações sem solventes, de onde vêm e o que muda entre elas.</p></div></div><div class="mast-actions"><div class="lang-switch" aria-label="Idioma / Language"><button id="langPT" class="active" type="button" aria-pressed="true">PT</button><button id="langEN" type="button" aria-pressed="false">EN</button></div><div class="counter"><small id="counterLabel">etapa</small><span id="counter">01 / 07</span></div></div></header><nav class="progress" id="progress"><button class="active" data-step="0"><span class="num">01</span><span class="label">Dry Sift Hash</span></button><button data-step="1"><span class="num">02</span><span class="label">Ice Water Hash</span></button><button data-step="2"><span class="num">03</span><span class="label">Flower Rosin</span></button><button data-step="3"><span class="num">04</span><span class="label">Hash Rosin</span></button><button data-step="4"><span class="num">05</span><span class="label">Live Hash</span></button><button data-step="5"><span class="num">06</span><span class="label">Live Hash Rosin</span></button><button data-step="6"><span class="num">07</span><span class="label">Comparação</span></button></nav><main class="stage"><article class="page" id="page"><div class="media" id="media"><img id="stageImage" alt=""></div><section class="story" id="story"><div class="kicker" id="kicker">01 · separação a seco</div><h2 id="title">Dry Sift Hash</h2><p class="lead" id="lead">O <strong>hash, ou haxixe</strong>, é um concentrado feito a partir da resina da cannabis. Essa resina se concentra principalmente nos <strong>tricomas</strong>, pequenas estruturas que recobrem a flor.</p><dl class="facts" id="facts"><div class="fact"><dt>Como é obtido</dt><dd>No Dry Sift, flor seca e curada passa por telas. Os tricomas que se desprendem são coletados.</dd></div><div class="fact"><dt>Kief</dt><dd>O material solto, rico em tricomas, coletado nessa separação é chamado <strong>kief</strong>.</dd></div><div class="fact"><dt>Micragem</dt><dd>As telas têm aberturas medidas em <strong>microns (µm)</strong>. Micragens diferentes deixam passar partículas de tamanhos diferentes.</dd></div><div class="fact"><dt>O resultado</dt><dd>A fração rica em tricomas separada a seco dá origem ao <strong>Dry Sift Hash</strong>.</dd></div></dl><div class="key" id="key"><strong>Flor → tricomas → resina separada → Hash.</strong></div></section><section class="final-page" id="finalPage"><div class="final-top"><div class="kicker" id="finalKicker">07 · comparação</div><h2 id="finalTitle">Como os nomes se formam.</h2><p class="lead" id="finalLead">Comece pela matéria-prima. Depois veja como os tricomas foram separados. Se o Hash for prensado, ele vira Rosin.</p><div class="final-rules" id="finalReadingList"></div></div><div class="flow-map" id="families"></div><div class="final-warning" id="finalKey"></div><div id="finalReadingTitle" hidden></div><div id="finalSummary" hidden></div></section></article><aside class="rail"><div id="mentalMap" class="mental-map-card"><div class="rail-kicker" id="mapKicker">índice das extrações</div><h3 id="mapTitle">Onde se encaixa</h3><p id="mapIntro">Hash obtido por separação a seco.</p><div class="mindmap" id="mindmap"></div></div></aside></main><div class="controls"><button class="ctrl" id="prev">← anterior</button><div class="instruction" id="instruction">Próximo: Ice Water Hash →</div><button class="ctrl" id="next">próxima →</button></div></div><script>
