  lead:`<strong>Hash Rosin</strong> é Rosin feito a partir de Hash previamente separado, e não diretamente da flor inteira.`,
  facts:[
    ["O caminho","flor → Hash → calor + pressão → Hash Rosin"],
    ["Matéria-prima","Um Hash rico em tricomas entra na prensagem."],
    ["O que muda","Essa matéria-prima já contém menos matéria vegetal do que a flor inteira e é mais concentrada em resina."],
    ["Em relação ao Flower Rosin","Flower Rosin começa na flor. Hash Rosin começa no Hash."]
  ],
  key:`<strong>Hash Rosin = Hash prensado para formar Rosin.</strong>`
},
{
  nav:"Live Hash",
  kicker:"05 · origem Fresh Frozen",
  title:"Live Hash",
  image:images.live,
  lead:`<strong>Live Hash</strong> parte de <strong>Fresh Frozen</strong>: flor congelada ainda fresca, antes da secagem e cura.`,
  facts:[
    ["O caminho","Fresh Frozen → água muito fria → separação dos tricomas → Live Hash"],
    ["O que significa Live","<strong>Live</strong> indica a origem Fresh Frozen."],
    ["A separação","Pertence à mesma família do Ice Water Hash."],
    ["Em relação ao Ice Water Hash","Ice Water Hash pode partir de material seco. Live Hash parte de material fresco congelado."]
  ],
  key:`<strong>Live = origem Fresh Frozen.</strong>`
},
{
  nav:"Live Hash Rosin",
  kicker:"06 · Live Hash prensado",
  title:"Live Hash Rosin",
  image:images.rosinLive,
  lead:`<strong>Live Hash Rosin</strong> é Rosin feito a partir de Live Hash. O próprio nome descreve a origem e as etapas anteriores.`,
  facts:[
    ["Live","A matéria-prima original é Fresh Frozen."],
    ["Hash","Os tricomas são separados para formar Live Hash."],
    ["Rosin","O Live Hash é então prensado."],
    ["O caminho","Fresh Frozen → Live Hash → calor + pressão → Live Hash Rosin"]
  ],
  key:`<strong>Live + Hash + Rosin = origem Fresh Frozen + Hash + prensagem.</strong>`
},
{
  nav:"Comparação",
  kicker:"07 · diferenças na prática",
  title:"O que muda entre eles?",
  image:null,
  lead:`A comparação passa por aroma, pureza física, concentração, presença de matéria vegetal, qualidade e experiência sensorial.`,
  facts:[],
  key:`O método de extração não determina sozinho qualidade, potência ou efeito terapêutico.`
}
];


