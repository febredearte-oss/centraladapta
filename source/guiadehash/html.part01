<!doctype html><html lang="pt-BR"><head><meta name="adapta-route" content="guiadehash"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Adapta — Um guia pra entender melhor o universo das extrações</title><meta name="description" content="Um guia da Adapta pra entender melhor o universo das extrações: Dry Sift, Ice Water Hash, Rosin, Live Hash e Live Hash Rosin."><style>:root{--bg:#ebe7dc;--paper:#fffdf7;--ink:#1f2924;--muted:#68776e;--green:#2e3d33;--green-2:#6b8a7a;--rule:rgba(46,61,51,.17);--rule-soft:rgba(46,61,51,.085);}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif}body{min-height:100vh;overflow:auto}button{font:inherit}.shell{width:min(1680px,calc(100vw - 34px));margin:0 auto;padding:14px 0 16px;}.masthead{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:start;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--rule);}.brand-lockup{display:grid;grid-template-columns:54px minmax(0,1fr);gap:14px;align-items:start;}.brand-logo{width:54px;height:auto;display:block;margin-top:2px}.brand-copy{min-width:0}.masthead .overline{margin:0 0 4px;color:var(--green-2);font-size:8.5px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;}.masthead h1{max-width:1080px;margin:0;color:var(--green);font-family:Georgia,'Times New Roman',serif;font-size:clamp(34px,3.28vw,54px);line-height:.95;letter-spacing:-.04em;font-weight:400;}.masthead p{max-width:920px;margin:7px 0 0;color:var(--muted);font-size:12px;line-height:1.45;}.mast-actions{display:flex;align-items:center;gap:14px;padding-top:2px}.lang-switch{display:flex;align-items:center;padding:3px;border:1px solid var(--rule);border-radius:999px;}.lang-switch button{border:0;border-radius:999px;background:transparent;color:#8b9d93;padding:5px 8px;font-size:8.5px;font-weight:900;letter-spacing:.08em;cursor:pointer;}.lang-switch button.active{background:var(--green);color:var(--paper)}.counter{color:var(--green);font-family:Georgia,'Times New Roman',serif;font-size:18px;white-space:nowrap;}.counter small{margin-right:6px;color:#89988f;font-family:Arial,Helvetica,sans-serif;font-size:8px;letter-spacing:.12em;text-transform:uppercase;}.progress{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));margin:0 0 10px;border-bottom:1px solid var(--rule);}.progress button{position:relative;min-width:0;border:0;background:transparent;padding:0 10px 10px 0;color:#87978e;text-align:left;cursor:pointer;}.progress button::after{content:"";position:absolute;left:0;bottom:-1px;width:0;height:1px;background:var(--green);transition:width .18s ease;}.progress button.active{color:var(--green)}.progress button.active::after{width:92%}.progress .num{display:inline;margin-right:6px;font-size:7px;font-weight:900;letter-spacing:.11em;}.progress .label{display:inline;font-size:10px;font-weight:800;line-height:1.2;}.stage{display:grid;grid-template-columns:minmax(0,1fr) 225px;gap:26px;align-items:start;}.page{display:grid;grid-template-columns:minmax(560px,1.08fr) minmax(500px,.92fr);gap:28px;align-items:center;}.media{height:clamp(410px,47vh,500px);overflow:hidden;background:rgba(214,227,214,.42);}.media>img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;}.story{min-width:0;padding:10px 0 0;display:flex;flex-direction:column;justify-content:center;}.kicker{margin-bottom:8px;color:var(--green-2);font-size:8px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;}.story h2{margin:0 0 12px;color:var(--green);font-family:Georgia,'Times New Roman',serif;font-size:clamp(48px,4.42vw,72px);line-height:.9;letter-spacing:-.052em;font-weight:400;}.lead{max-width:720px;margin:0 0 14px;color:var(--ink);font-size:15px;line-height:1.52;}.lead strong{color:var(--green)}.key{order:4;margin:0 0 12px;padding:10px 0 11px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);color:var(--green);font-family:Georgia,'Times New Roman',serif;font-size:18px;line-height:1.34;letter-spacing:-.012em;}.key strong{font-weight:400}.story .kicker{order:1}.story h2{order:2}.story .lead{order:3}.story .facts{order:5}.facts{margin:0;border:0}.fact{display:grid;grid-template-columns:128px minmax(0,1fr);gap:15px;padding:8px 0;border-bottom:1px solid var(--rule-soft);}.fact dt{margin:0;color:var(--green-2);font-size:8.4px;font-weight:900;line-height:1.3;letter-spacing:.08em;text-transform:uppercase;}.fact dd{margin:0;color:var(--muted);font-size:12.5px;line-height:1.48;}.fact dd strong{color:var(--ink)}.page[data-step="0"],.page[data-step="1"]{grid-template-columns:minmax(600px,1.12fr) minmax(485px,.88fr);}.page[data-step="2"],.page[data-step="3"]{grid-template-columns:minmax(530px,1.02fr) minmax(515px,.98fr);}.page[data-step="4"],.page[data-step="5"]{grid-template-columns:minmax(585px,1.10fr) minmax(495px,.90fr);}.page[data-step="4"] .media>img{object-position:47% center}.page[data-step="5"] .media>img{object-position:52% center}.rail{padding:6px 0 0 18px;border-left:1px solid var(--rule);align-self:stretch;}.rail .rail-kicker{margin-bottom:10px;color:var(--green-2);font-size:8px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;}.rail h3{margin:0 0 6px;color:var(--green);font-size:12px;line-height:1.22;font-weight:900;}.rail p{margin:0 0 12px;color:var(--muted);font-size:11px;line-height:1.42;}.mindmap{margin:0;display:flex;flex-direction:column;gap:10px;}.mm-summary{display:none}.mm-group{position:relative;padding:4px 0 10px;}.mm-group + .mm-group{border-top:1px solid var(--rule-soft);padding-top:11px;}.mm-group-title{margin-bottom:7px;color:var(--green-2);font-size:7.8px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;}.mm-group.current-group .mm-group-title{color:var(--green)}.mm-group-caption{display:none}.mm-node{position:relative;padding:5px 0 5px 15px;color:#738178;line-height:1.25;}.mm-node::before{content:"";position:absolute;left:0;top:9px;width:5px;height:5px;border:1px solid rgba(46,61,51,.25);border-radius:50%;background:transparent;}.mm-node[data-level="1"]{margin-left:13px;padding-left:17px;}.mm-node[data-level="1"]::after{content:"↳";position:absolute;left:0;top:3px;color:var(--green-2);font-size:10px;}.mm-node[data-level="1"]::before{left:7px;}.mm-node .node-label{display:block;color:inherit;font-size:11px;font-weight:800;}.mm-node .node-meta{display:none;}.mm-node.related{color:#596a61}.mm-node.related::before{background:#b5c1ba;border-color:#b5c1ba;}.mm-node.future{opacity:.38}.mm-node.current{color:var(--green);font-weight:900;}.mm-node.current::before{background:var(--green);border-color:var(--green);box-shadow:0 0 0 3px rgba(107,138,122,.13);}.controls{display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;margin-top:14px;padding-top:10px;border-top:1px solid var(--rule);}.ctrl{border:0;background:transparent;color:var(--green);padding:4px 0;font-size:10px;font-weight:800;cursor:pointer;}.ctrl:disabled{opacity:.28;cursor:default}.ctrl:not(:disabled):hover{text-decoration:underline;text-underline-offset:4px}.instruction{color:#85938b;font-size:10px;text-align:center;}.page.final{display:block;width:100%;}.stage.final-stage{grid-template-columns:1fr;}.stage.final-stage .rail{display:none;}.final-page{display:block;width:100%;padding:4px 0 2px;}.final-top{display:grid;grid-template-columns:minmax(260px,.34fr) minmax(0,.66fr);grid-template-areas:"kicker rules" "title rules" "lead rules";column-gap:42px;align-items:end;padding:0 0 18px;border-bottom:1px solid var(--rule);}.final-top .kicker{grid-area:kicker;}.final-top h2{grid-area:title;max-width:520px;margin:3px 0 10px;color:var(--green);font-family:Georgia,'Times New Roman',serif;font-size:clamp(42px,3.6vw,58px);line-height:.93;letter-spacing:-.048em;font-weight:400;}.final-top .lead{grid-area:lead;max-width:570px;margin:0;font-size:13px;line-height:1.48;}.final-rules{grid-area:rules;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;align-self:end;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);}.rule-chip{padding:12px 14px;}.rule-chip + .rule-chip{border-left:1px solid var(--rule);}.rule-chip strong{display:block;margin-bottom:4px;color:var(--green);font-family:Georgia,'Times New Roman',serif;font-size:17px;line-height:1;font-weight:400;}.rule-chip span{display:block;color:var(--muted);font-size:10px;line-height:1.35;}.flow-map{margin-top:18px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);}.flow-head,.flow-row{display:grid;grid-template-columns:1.05fr .95fr 1.1fr 1.1fr;min-width:0;}.flow-head{color:var(--green-2);font-size:8px;font-weight:900;letter-spacing:.11em;text-transform:uppercase;}.flow-head>div{padding:9px 14px;}.flow-row{position:relative;min-height:102px;border-top:1px solid var(--rule-soft);}.flow-row.direct{background:rgba(214,227,214,.12);}.flow-cell{position:relative;min-width:0;padding:14px 16px;}.flow-cell + .flow-cell{border-left:1px solid var(--rule-soft);}.flow-cell:not(:last-child)::after{content:"→";position:absolute;right:-8px;top:50%;transform:translateY(-50%);z-index:2;width:16px;height:16px;display:grid;place-items:center;background:var(--bg);color:var(--green-2);font-size:12px;}.flow-label{margin-bottom:6px;color:var(--green-2);font-size:7.5px;font-weight:900;letter-spacing:.09em;text-transform:uppercase;}.flow-name{color:var(--green);font-family:Georgia,'Times New Roman',serif;font-size:20px;line-height:1.08;}.flow-name.small{font-size:16px;}.flow-copy{margin-top:6px;color:var(--muted);font-size:10.5px;line-height:1.38;}.flow-empty{color:#9da79f;font-size:10px;line-height:1.35;font-style:italic;}.final-warning{max-width:720px;margin-top:12px;color:var(--muted);font-size:10.2px;line-height:1.42;}.final-warning strong{color:var(--green);}@media(max-width:1040px){.final-top{grid-template-columns:1fr;grid-template-areas:"kicker" "title" "lead" "rules";row-gap:0;}.final-rules{margin-top:16px;}.flow-map{overflow-x:auto;}.flow-head,.flow-row{min-width:820px;}}@media(max-width:680px){.final-rules{grid-template-columns:1fr;}.rule-chip + .rule-chip{border-left:0;border-top:1px solid var(--rule);}}@media(max-width:1320px){.shell{width:min(100vw - 24px,1540px)}.stage{grid-template-columns:minmax(0,1fr) 225px;gap:22px}.page,.page[data-step="0"],.page[data-step="1"],.page[data-step="2"],.page[data-step="3"],.page[data-step="4"],.page[data-step="5"]{grid-template-columns:minmax(430px,1.02fr) minmax(390px,.98fr);gap:24px;}.media{height:clamp(365px,42vh,445px)}.story h2{font-size:clamp(42px,4vw,62px)}}@media(max-width:1040px){.shell{width:calc(100% - 22px)}.stage{grid-template-columns:1fr;gap:16px}.rail{padding:12px 0 0;border-left:0;border-top:1px solid var(--rule);}.mindmap{display:grid;grid-template-columns:1fr 1fr;gap:0 24px}.page,.page[data-step="0"],.page[data-step="1"],.page[data-step="2"],.page[data-step="3"],.page[data-step="4"],.page[data-step="5"]{grid-template-columns:minmax(