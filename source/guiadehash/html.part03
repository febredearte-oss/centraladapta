const stepsEN = [
{
  nav:"Dry Sift Hash", kicker:"01 · dry separation", title:"Dry Sift Hash", image:images.dry,
  lead:`<strong>Hash</strong> is a concentrate made from cannabis resin. This resin is concentrated mainly in <strong>trichomes</strong>, small structures that cover the flower.`,
  facts:[
    ["How it is obtained","In Dry Sift, dried and cured flower passes over screens. The trichomes that detach are collected."],
    ["Kief","The loose, trichome-rich material collected during separation is called <strong>kief</strong>."],
    ["Micron size","The screens have openings measured in <strong>microns (µm)</strong>. Different micron sizes allow particles of different sizes to pass."],
    ["The result","The trichome-rich fraction separated dry becomes <strong>Dry Sift Hash</strong>."]
  ],
  key:`<strong>Flower → trichomes → separated resin → Hash.</strong>`
},
{
  nav:"Ice Water Hash", kicker:"02 · cold-water separation", title:"Ice Water Hash", image:images.ice,
  lead:`In <strong>Ice Water Hash</strong>, trichomes are separated in very cold water rather than through dry separation.`,
  facts:[
    ["How it is obtained","The cold helps trichomes detach from the plant. The water then passes through screens with different micron sizes."],
    ["Other names","It may also appear as <strong>Bubble Hash</strong> or <strong>Ice-O-Lator</strong>."],
    ["During separation","Water filtration can provide greater control over collected fractions and reduce the presence of plant material."],
    ["Compared with Dry Sift","Dry Sift Hash = dry separation. Ice Water Hash = separation in very cold water."]
  ],
  key:`<strong>The difference is how the trichomes are separated: dry or in cold water.</strong>`
},
{
  nav:"Flower Rosin", kicker:"03 · flower pressing", title:"Flower Rosin", image:images.rosin,
  lead:`<strong>Rosin</strong> is a concentrate obtained through controlled heat and pressure. In <strong>Flower Rosin</strong>, the flower itself is pressed.`,
  facts:[
    ["Raw material","Cannabis flower."],
    ["The path","flower → heat + pressure → Flower Rosin"],
    ["Compared with Hash","There is no prior step separating trichomes to form Hash."],
    ["The name","<strong>Flower</strong> identifies the raw material. <strong>Rosin</strong> identifies the concentrate obtained by pressing."]
  ],
  key:`<strong>Flower Rosin = Rosin made directly from flower.</strong>`
},
{
  nav:"Hash Rosin", kicker:"04 · Hash pressing", title:"Hash Rosin", image:images.rosinHash,
  lead:`<strong>Hash Rosin</strong> is Rosin made from previously separated Hash rather than directly from whole flower.`,
  facts:[
    ["The path","flower → Hash → heat + pressure → Hash Rosin"],
    ["Raw material","A trichome-rich Hash enters the pressing step."],
    ["What changes","The starting material contains less plant matter than whole flower and is more concentrated in resin."],
    ["Compared with Flower Rosin","Flower Rosin starts with flower. Hash Rosin starts with Hash."]
  ],
  key:`<strong>Hash Rosin = Hash pressed into Rosin.</strong>`
},
{
  nav:"Live Hash", kicker:"05 · Fresh Frozen origin", title:"Live Hash", image:images.live,
  lead:`<strong>Live Hash</strong> starts with <strong>Fresh Frozen</strong>: flower frozen while still fresh, before drying and curing.`,
  facts:[
    ["The path","Fresh Frozen → very cold water → trichome separation → Live Hash"],
    ["What Live means","<strong>Live</strong> indicates a Fresh Frozen origin."],
    ["The separation","It belongs to the same family as Ice Water Hash."],
    ["Compared with Ice Water Hash","Ice Water Hash may start with dried material. Live Hash starts with fresh-frozen material."]
  ],
  key:`<strong>Live = Fresh Frozen origin.</strong>`
},
{
  nav:"Live Hash Rosin", kicker:"06 · pressed Live Hash", title:"Live Hash Rosin", image:images.rosinLive,
  lead:`<strong>Live Hash Rosin</strong> is Rosin made from Live Hash. The name describes both the origin and the previous stages.`,
  facts:[
    ["Live","The original material is Fresh Frozen."],
    ["Hash","The trichomes are separated to form Live Hash."],
    ["Rosin","The Live Hash is then pressed."],
    ["The path","Fresh Frozen → Live Hash → heat + pressure → Live Hash Rosin"]
  ],
  key:`<strong>Live + Hash + Rosin = Fresh Frozen origin + Hash + pressing.</strong>`
},
{
  nav:"Comparison", kicker:"07 · practical differences", title:"What changes between them?", image:null,
