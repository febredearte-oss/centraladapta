{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "centraladapta",
  "main": "src/worker-holiday-local-import.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "account_id": "dca97af6a15592dde7c8119ef1f7ff94",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "central-adapta-db",
      "database_id": "da96a644-571b-418f-8e9d-15040bd04ffe"
    }
  ],
  "build": {
    "command": "node scripts/materialize-index.mjs && node scripts/materialize-guiadehash.mjs && node scripts/patch-guiadehash-mobile.mjs && node scripts/patch-calendar-theme.mjs && node scripts/patch-header-brand.mjs && node scripts/patch-ui-polish.mjs && node scripts/patch-system-visual-cleanup.mjs && node scripts/patch-sidebar-nav.mjs && node scripts/patch-overview-workdesk.mjs && node scripts/patch-overview-official-clock.mjs && node scripts/patch-open-layout-polish.mjs && node scripts/patch-svg-id-collisions.mjs && node scripts/patch-color-palette.mjs && node scripts/patch-system-visual-compact.mjs && node scripts/patch-slot-posted.mjs && node scripts/patch-calendar-today.mjs && node scripts/patch-runtime-errors.mjs && node scripts/patch-holiday-local-recovery.mjs && node scripts/patch-holiday-progress.mjs && node scripts/patch-shared-state-sync.mjs && node scripts/patch-dynamic-slots.mjs && node scripts/patch-favicon.mjs"
  }
}
